#### Настройки PayloadCMS и SERVER_URL #######
PAYLOAD_SECRET=69e3ee6ff6a1154b863e7804
# Публичный адрес сайта. Пока nginx работает по HTTP (порт 80) — оставляем http://
SERVER_URL=https://telemed.smartcardio.ru
DATABASE_URL=postgresql://postgres:11559966332211kkKK@127.0.0.1:5432/telemed

# Куда Payload складывает загруженные файлы (коллекция media).
# Оставьте пустым — будет <корень проекта>/media, папка создаётся автоматически
# при старте. Укажите АБСОЛЮТНЫЙ путь, если файлы должны жить вне каталога
# деплоя (иначе они пропадут при пересборке/перевыкладке):
#   MEDIA_DIR=/var/www/telemed-media
# Пользователь, под которым запущен Next.js, должен иметь права на запись:
#   sudo mkdir -p /var/www/telemed-media
#   sudo chown -R $USER:$USER /var/www/telemed-media
MEDIA_DIR=


#### Оплата — ЮKassa (https://yookassa.ru/developers/api) #######
# Без этих двух ключей оплата отдаёт 503, а запись остаётся в «Ожидает оплаты».
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# В кабинете ЮKassa (Интеграция -> HTTP-уведомления) укажите адрес:
#   https://telemed.smartcardio.ru/api/payments/yookassa/notification
# и события: payment.succeeded, payment.canceled, refund.succeeded.
# Уведомления приходят без подписи, поэтому отправитель проверяется по IP
# из официального списка (src/lib/constants/yookassa-ips.ts).
# Переопределить список (если ЮKassa его изменит) — здесь, через запятую:
YOOKASSA_NOTIFICATION_IPS=
# ТОЛЬКО для локальной отладки вебхука: отключает проверку IP. На проде — false.
YOOKASSA_TRUST_ALL_IPS=false

# Данные чека (54-ФЗ). Если у магазина нет онлайн-фискализации, поставьте false.
YOOKASSA_SEND_RECEIPT=true
# vat_code позиции чека: 1 — без НДС, 2 — 0%, 3 — 10%, 4 — 20%, 5 — 10/110, 6 — 20/120
YOOKASSA_VAT_CODE=1
YOOKASSA_PAYMENT_SUBJECT=service
YOOKASSA_PAYMENT_MODE=full_prepayment


#### Настройки Сокетов и PeerJs #######
# Домен один и тот же для сайта/сокетов/mediasoup — маршрутизация по path в nginx
NEXT_PUBLIC_SOCKET_URL=https://telemed.smartcardio.ru
NEXT_PUBLIC_SOCKET_PATH=/socket.io
# Путь socket.io-сервера должен совпадать с NEXT_PUBLIC_SOCKET_PATH
SOCKET_PATH=/socket.io
NEXT_PUBLIC_PEER_HOST=telemed.smartcardio.ru
NEXT_PUBLIC_PEER_PORT=80
NEXT_PUBLIC_PEER_PATH=/peerjs
NEXT_PUBLIC_MEDIASOUP_PATH=/mediasoup
SOCKET_ALLOWED_ORIGINS=https://telemed.smartcardio.ru

# Порт сокет-сервера (nginx проксирует /socket.io/ -> 3001)
SOCKET_PORT=3001


#### Настройки MediaSoup (порт сигналинга 3002 + диапазон WebRTC) #######
NEXT_PUBLIC_USE_MEDIASOUP=true
# nginx маппит /mediasoup/ на 127.0.0.1:3002 (Socket.IO и POST /rooms/:id/leave)
NEXT_PUBLIC_MEDIASOUP_URL=https://telemed.smartcardio.ru
MEDIASOUP_PORT=3002
MEDIASOUP_CORS_ORIGINS=https://telemed.smartcardio.ru
# Публичный IP сервера: WebRTC-медиа идёт напрямую, минуя nginx.
MEDIASOUP_ANNOUNCED_IP=79.174.77.110
MEDIASOUP_LISTEN_IP=0.0.0.0
# Откройте весь диапазон для UDP и TCP: 40000:49999
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=49999
MEDIASOUP_NUM_WORKERS=1
# ICE fallback через ваш coturn. Значения остаются серверными и выдаются только
# авторизованным участникам конкретной консультации через /api/mediasoup/token.
# Несколько URL перечисляются через запятую. Для строгих сетей добавьте UDP, TCP и TLS.
STUN_URLS=stun:turn.example.com:3478
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_USERNAME=replace-with-coturn-username
TURN_CREDENTIAL=replace-with-coturn-password
# Один длинный случайный секрет (минимум 32 символа) для room JWT и внутренних запросов.
MEDIASOUP_SERVER_SECRET=replace-with-at-least-32-random-characters
NEXTJS_URL=http://127.0.0.1:3000

# Способ записи консультаций. Одна переменная на весь проект, режимы
# взаимоисключающие - двух записей на одну консультацию быть не может.
#   server - FFmpeg на mediasoup-сервере. Не грузит браузер врача (нужен ffmpeg).
#   client - MediaRecorder в браузере врача (~0.9 Мбит/с аплинка, ~20% ядра).
#   off    - запись не ведётся.
# Значение по умолчанию (если переменная не задана) - server.
# NEXT_PUBLIC_* инлайнится на сборке: после смены нужен пересбор фронтенда,
# а не только рестарт mediasoup.
NEXT_PUBLIC_RECORDING_MODE=server
# Путь к ffmpeg, если он не в PATH (актуально только для режима server).
# FFMPEG_PATH=/usr/bin/ffmpeg
